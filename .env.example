# Als .env neben compose.yaml speichern; Werte für das eigene NAS anpassen.
KITAFENSTER_IMAGE=ghcr.io/aldevelope-code/kitafenster
KITAFENSTER_VERSION=0.2.1
NAS_PATH=/volume1/Kita-Bilderrahmen
DATA_PATH=/volume1/docker/kitafenster/data
# Über den DSM-Aufgabenplaner ermitteln, siehe docs/INSTALLATION-NAS.md.
# 10001 ist nur der interne Image-Standard, kein allgemein gültiges NAS-Konto.
NAS_UID=10001
NAS_GID=10001
# Zusatzgruppe mit Leserecht, z. B. die GID von administrators.
# Ohne Zusatzgruppe leer lassen; Compose verwendet dann NAS_GID.
NAS_READ_GID=
# IP des NAS; alternativ 0.0.0.0 für alle Schnittstellen im LAN.
BIND_ADDRESS=0.0.0.0
# Bei HTTPS über den DSM-Reverse-Proxy auf true setzen.
COOKIE_SECURE=false
# Anmeldung: ADMIN_PASSWORD aktivieren und das eigene Passwort eintragen.
# Einfache Anführungszeichen erhalten Zeichen wie $ und # unverändert.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD='mein Passwort'
# Keine Mindestlänge oder Zeichenregeln; ADMIN_PASSWORD='' erlaubt ein leeres Passwort.
# Ohne ADMIN_PASSWORD bleibt ein bereits angelegtes Konto unverändert.
